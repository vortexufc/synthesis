[sub_resource type="Shader" id="Shader_blur"]
code = "shader_type canvas_item;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;
uniform float lod: hint_range(0.0, 5.0) = 3.0;
uniform vec4 escurecer: source_color = vec4(0.05, 0.06, 0.10, 0.6);
void fragment(){
	vec4 color = textureLod(SCREEN_TEXTURE, SCREEN_UV, lod);
	COLOR = mix(color, escurecer, escurecer.a);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_blur"]
shader = SubResource("Shader_blur")
shader_parameter/lod = 3.0
shader_parameter/escurecer = Color(0.05, 0.06, 0.1, 0.6)

